<?xml version="1.0"?>
<sdf version="1.6">
  <model name="kangaroo">
    <static>true</static>

    <link name="body">
      <visual name="kangaroo_visual">
        <geometry>
          <mesh>
            <uri>model://SomeKangaroo/meshes/kangaroo.stl</uri>
            <!-- The STL is in centimetres; convert it to metres. -->
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>

        <material>
          <ambient>0.35 0.18 0.08 1</ambient>
          <diffuse>0.55 0.28 0.10 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="collision">
        <!-- Approximate the scaled mesh's bounding box. -->
        <pose>1.25 1.05 0.776 0 0 0</pose>
        <geometry>
          <box>
            <size>0.934 1.660 1.552</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
