<?xml version="1.0"?>
<sdf version="1.8">
  <world name="TerrainWorld">
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <direction>-0.5 0.5 -1</direction>
      <diffuse>1 1 1 1</diffuse>
    </light>

    <model name="terrain">
      <static>true</static>

      <link name="terrain_link">
        <collision name="collision">
          <geometry>
            <heightmap>
              <uri>../models/GreyHeatMapV2/e9836408f061fe241792508fc50c1535dea7810a.png</uri>
              <size>50 50 2.5</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <mesh>
              <uri>../models/GreyHeatMapV2/GreyMapV2Terrain.obj</uri>
              <scale>0.5 0.5 0.166667</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>




      <!-- Rocks -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Falling%20Rock%201</uri>
      <name>rocks1</name>
      <pose>-3 -2 5 0 0 0</pose>
      <static>false</static>
    </include>

    <!-- Vegetation heights follow the scaled terrain mesh, including mesh base offsets. -->
    <!-- Oak tree -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree
      </uri>
      <name>oak1</name>
      <pose>-16 -14 1.037 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree
      </uri>
      <name>oak2</name>
      <pose>0 -14 1.371 0 0 0</pose>
      <static>true</static>
    </include>

        <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree
      </uri>
      <name>oak3</name>
      <pose>16 -14 1.764 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree
      </uri>
      <name>oak4</name>
      <pose>-16 14 1.056 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree
      </uri>
      <name>oak5</name>
      <pose>0 14 0.985 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree
      </uri>
      <name>oak6</name>
      <pose>16 14 0.352 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree
      </uri>
      <name>oak7</name>
      <pose>2 3 0.867 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- Pine tree -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine%20tree
      </uri>
      <name>pine1</name>
      <pose>5.0 0.0 1.098 0 0 0</pose>
      <static>true</static>
    </include>  

    <!-- Kangaroo -->
    <include>
      <uri>model://SomeKangaroo</uri>
      <name>kangaroo</name>
      <pose>2 0 0.960 0 0 0</pose>
      <static>true</static>
    </include>

    <!--dry grass-->
    <include>
       <uri>model://Dry_Grass</uri>
       <name>dry_grass</name>
       <pose>0 -2 1.057 0 0 0</pose>
       <static>true</static>
    </include>

    <include>
       <uri>model://Dry_Grass</uri>
       <name>dry_grass_2</name>
       <pose>-12 -12 0.793 0 0 0</pose>
       <static>true</static>
    </include>

    <include>
       <uri>model://Dry_Grass</uri>
       <name>dry_grass_3</name>
       <pose>12 -12 1.171 0 0 0</pose>
       <static>true</static>
    </include>

    <include>
       <uri>model://Dry_Grass</uri>
       <name>dry_grass_4</name>
       <pose>-12 12 0.739 0 0 0</pose>
       <static>true</static>
    </include>

    <include>
       <uri>model://Dry_Grass</uri>
       <name>dry_grass_5</name>
       <pose>12 12 0.634 0 0 0</pose>
       <static>true</static>
    </include>
  </world>
</sdf>

