<?xml version="1.0"?>
<sdf version="1.8">
  <world name="TerrainWorld">

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <direction>-0.5 0.5 -1</direction>
      <diffuse>1 1 1 1</diffuse>
    </light>

    <model name="terrain">
      <static>true</static>

      <link name="terrain_link">
        <collision name="collision">
          <geometry>
            <heightmap>
              <uri>../models/GreyHeatMapV2/e9836408f061fe241792508fc50c1535dea7810a.png</uri>
              <size>100 100 15</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <mesh>
              <uri>../models/GreyHeatMapV2/GreyMapV2Terrain.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>

