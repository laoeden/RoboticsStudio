<?xml version="1.0"?>
<sdf version='1.8'>
  <world name="simple_trees">
    <!-- Basic world setup  -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <shadows>1</shadows>
    </scene>

    <!-- Initialise spherical coordinates somewhere -->
    <spherical_coordinates>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>0.0</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <!-- Small ground plane with grass texture -->
    <include>
      <uri>
        model://grass_plane
      </uri>
      <name>grass_plane</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Oak tree -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree
      </uri>
      <name>oak1</name>
      <pose>0 3.0 0 0 0 0</pose>
    </include>
    
    <!-- Pine tree -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine%20tree
      </uri>
      <name>pine1</name>
      <pose>5.0 0.0 0 0 0 0</pose>
    </include>

    <!-- Rocks -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Falling%20Rock%201</uri>
      <name>rocks1</name>
      <pose>-3 2 1 0 0 0</pose>
    </include>

    <!-- Kangaroo -->
    <include>
      <uri>model://SomeKangaroo</uri>
      <name>kangaroo</name>
      <pose>2 0 0 0 0 0</pose>
    </include>

    <!--dry grass-->
    <include>
       <uri>model://Dry_Grass</uri>
       <name>dry_grass</name>
       <pose>0 0 0 0 0 0</pose>
    </include>

    <!--hills-->
    <model name="hill_1">
      <static>true</static>
      <pose>15 10 -6 0 0 0</pose>

      <link name="hill_link">
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>10</radius>
            </sphere>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <sphere>
              <radius>10</radius>
            </sphere>
          </geometry>

          <material>
            <ambient>0.15 0.45 0.10 1</ambient>
            <diffuse>0.20 0.55 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>


<!--
cd ~/git/RoboticsStudio
IGN_GAZEBO_RESOURCE_PATH="$PWD/models" ign gazebo -v 4 world/simple_trees.sdf

this is the command to run the world for now

or 

ros2 launch 41068_ignition_bringup 41068_ignition_husky.launch.py world:=simple_trees
-->
